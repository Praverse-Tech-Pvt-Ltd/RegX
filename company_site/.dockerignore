# Keep the build context small. The company tree is 728 MB, almost all of it
# assets that the application process never opens.

# nginx serves /static/ straight off the host tree (see compose.yaml), and
# Django only builds {% static %} URLs for the rest of this tree.
static/

# ...with one exception. RATools.views.download_document OPENS these files
# from STATICFILES_DIRS[0], so they have to exist inside the container:
#   /ratools/download/ANDAFacilityTemplate/
#   /ratools/download/TemplateforAPIFacilitydetails/
#   /ratools/download/Controlled Correspondences Templates/
# Excluding them made all three Download Document buttons return 404. ~4.4 MB.
!static/documents/

# media/ is bind-mounted read-write instead of baked in, so that uploads made
# by the running app and the files nginx serves are the same bytes.
media/

# Stale database backups copied for exactness; nothing reads them. The live
# db.sqlite3 is deliberately NOT excluded — docker-entrypoint.sh seeds the
# volume from it on first start.
db.sqlite3.bak
db_17_1_2.sqlite3
db_corrupted.sqlite3
db_old.sqlite3

# Local dev leftovers
.venv/
__pycache__/
*.pyc
staticfiles/
tmp/
.env
