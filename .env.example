# REGX environment configuration template.
# Copy to .env and fill in real values. NEVER commit .env to version control.

# Django
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets
DJANGO_SETTINGS_MODULE=regx.settings.development
APP_VERSION=0.1.0
APP_ENVIRONMENT=development

# Database (PostgreSQL only — SQLite is not supported)
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://regx:change-me-strong-password@localhost:5432/regx

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# MFA encryption key (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=change-me-generate-fernet-key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
