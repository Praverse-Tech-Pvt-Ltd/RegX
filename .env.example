# REGX environment configuration template.
# Copy to .env and fill in real values. NEVER commit .env to version control.

# --- The four HARD-REQUIRED variables ------------------------------------
# compose.yaml guards these with `:?`, so `docker compose config` fails and
# names any one that is missing. Everything else in this file either has a
# default or is supplied by compose. See docs/DEPLOYMENT_BOUNDARIES.md.
#
# Validate before starting:  python scripts/check_env.py

# Django
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets
DJANGO_SETTINGS_MODULE=regx.settings.development
APP_VERSION=0.1.0
APP_ENVIRONMENT=development

# Database (PostgreSQL only — SQLite is not supported)
# HARD-REQUIRED. Compose gives this to postgres as POSTGRES_PASSWORD and to the
# backend and celery as DB_PASSWORD -- one credential, two names. Setting
# DB_PASSWORD yourself has no effect under compose.
POSTGRES_PASSWORD=change-me-strong-password
# DB_NAME / DB_USER / DB_HOST / DB_PORT are set by compose and are not needed
# here. Supply them only when running the backend outside compose.
#
# There is deliberately no DATABASE_URL: nothing in this codebase reads one.
# It was listed here and in the deployment docs for a while and was never read.

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Socket bounds for cache operations, in seconds. These stop a Redis that has
# stopped answering from hanging the readiness probe; they are a ceiling on
# hanging, not a latency target, so leave them well above normal Redis latency.
# The Celery broker deliberately does not use these -- an idle worker holds a
# blocking pop open on purpose.
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_READ_TIMEOUT_SECONDS=2

# MFA encryption key (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=change-me-generate-fernet-key

# CORS (compose overrides this; listed for non-compose runs)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend.
# NOT A SECRET: Next.js inlines every NEXT_PUBLIC_* value into the client
# bundle, so it is served to every visitor. Never put a credential here.
# Under compose this is derived from INTEGRATED_APP_URL below and is applied at
# BUILD time as well as runtime -- setting it only at runtime leaves whatever
# was baked into the image.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Integrated company site (company_site service)
# Its own Django SECRET_KEY, separate from DJANGO_SECRET_KEY above: the two
# applications sign their own sessions independently.
COMPANY_SECRET_KEY=change-me-generate-with-python-secrets

# Single-origin front door. Open this URL, not :3000 or :8000.
# NEXT_PUBLIC_API_URL is set to http://localhost:8080 by compose so the
# browser calls the API same-origin through nginx.
INTEGRATED_APP_URL=http://localhost:8080

# AI gateway (backend only; never set these for company_site).
# Leave every value empty until the provider details arrive. Real values go in
# your local .env only, never in a committed file, a ticket or a chat.
# AI runs only when REGX_AI_ENABLED is true AND a platform admin turns the
# platform switch on (PUT /api/regx/v1/ai/switch/). See docs/AI_INTEGRATION_RUNBOOK.md.
REGX_AI_ENABLED=false
# stub (offline, default) | e2e (production model) | openai (development only)
REGX_AI_PROVIDER=stub
REGX_AI_E2E_BASE_URL=
REGX_AI_E2E_API_KEY=
REGX_AI_E2E_MODEL=
REGX_AI_OPENAI_API_KEY=
REGX_AI_OPENAI_MODEL=
