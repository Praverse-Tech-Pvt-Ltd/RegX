# Copy to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave blank to derive from the incoming request; set explicitly if pages
# should always link back to a fixed public URL (e.g. the Render domain).
BASE_URL=
# Set to PRODUCTION to enable device-token/footprint-ID login lockdown.
# Anything else (including unset) uses the simplified local-dev login path.
SERVER=LOCAL

# SMTP email (django.core.mail)
EMAIL_HOST=smtp.office365.com
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Microsoft Graph (booking confirmation emails)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
BOOKING_EMAIL_HOST_USER=
BOOKING_HOST_EMAIL=inquiry@icretegy.com

# Transport security. All default to "on when DEBUG=False", so production is
# secure without extra config; override only for unusual setups.
# SECURE_HSTS_SECONDS starts at 3600 (1 hour). Browsers honour it for the full
# duration and it CANNOT be revoked early, so raise to 31536000 (1 year) only
# once HTTPS is confirmed stable on the real domain.
# SESSION_COOKIE_SECURE=
# CSRF_COOKIE_SECURE=
# SECURE_SSL_REDIRECT=
# SECURE_HSTS_SECONDS=
# SECURE_HSTS_INCLUDE_SUBDOMAINS=
# SECURE_HSTS_PRELOAD=
# Comma-separated, scheme included, e.g. https://example.onrender.com
CSRF_TRUSTED_ORIGINS=

# FDA 483 observation summaries. Generating them calls OpenAI once per
# observation block (~8k in the bundled workbook), synchronously inside a page
# request while CELERY_TASK_ALWAYS_EAGER is True. Leave False unless you
# intend to pay for a full generation pass; existing summaries are still served.
ENABLE_OBSERVATION_SUMMARIES=False

# Celery — set CELERY_TASK_ALWAYS_EAGER=False and provide a real
# CELERY_BROKER_URL once a Redis add-on is available (not needed for
# free-tier hosting without Redis).
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
