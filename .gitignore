# ============================================================
# REGX — regx-main branch .gitignore
# Legacy monolith files present on disk MUST NOT be committed.
# ============================================================

# Legacy monolith directories (root-anchored: an unanchored pattern here
# would also match same-named directories elsewhere in the tree, e.g.
# frontend/src/app/templates/ -- a real Next.js route, not the legacy
# Django template directory this was meant to exclude)
/AIDatabase/
/AdminMaster/
/RAAI/
/RATools/
/templates/
/staticfiles/
/static/
/media/
/tmp/

# Local FileSystemStorage output (MEDIA_ROOT default, backend/regx/settings/base.py)
# -- test/dev-only runtime artifacts, never source. Root-anchored and
# backend-scoped so it can't accidentally match an unrelated directory
# of the same name elsewhere in the tree.
/backend/document_storage/

# Legacy files in root
/manage.py
build.sh
render.yaml
REGULATORY_TECHNICAL_TOOLS_BASELINE_REPORT.md
REGULATORY_TOOLS_CODEBASE_INSPECTION_REPORT.md

# Legacy SQLite databases and backups
*.sqlite3
*.sqlite3.bak*
db*.sqlite3
db*.sqlite3.bak*

# ...but the integrated company site ships its own real database. The company
# homepage, Audit IQ and all 217 gated legacy tools render FDA-483 content out
# of this file, so the application is inert without it. Re-included explicitly
# because the legacy patterns above are deliberately unanchored.
# The four stale backups beside it (db.sqlite3.bak, db_17_1_2, db_corrupted,
# db_old) are copied to disk for exactness but stay untracked — they are dead
# weight in version control and nothing reads them.
!/company_site/db.sqlite3

# Legacy root-level requirements (REGX requirements live in backend/requirements/)
requirements.txt

# Claude Code project data
.claude/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.log

# Virtual environments
.venv/
venv/
env/

# Secrets — never commit real .env
.env
.env.local
.env.*.local
.env.docker.test
.env.docker.*

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
.eslintcache

# Playwright
playwright-report/
test-results/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Docker volumes
.docker/

# ---------------------------------------------------------------------------
# Company runtime assets — present on disk, deliberately not versioned.
# Rationale and restore instructions: docs/COMPANY_RUNTIME_ASSETS.md
# Restore with: scripts/sync_company_runtime_assets.sh
# ---------------------------------------------------------------------------

# Runtime media (196 MB): FDA-483 observation images reached through
# AIDatabase ImageField rows. Mutable, user-generated, per-deployment state;
# bind-mounted into the containers by compose.yaml.
/company_site/media/

# Dead marketing videos (82 MB): the only reference anywhere in the codebase
# is a commented-out line in templates/RATools/RAToolsBase.html:1638.
/company_site/static/videos/

# Data-import spreadsheets (14 MB): inputs to one-off management commands
# whose results already live in db.sqlite3. Never read while serving a
# request, and client-named, so better kept out of a shared repository.
/company_site/AIDatabase/management/commands/*.xlsx

# Backup sets produced by scripts/backup.sh. Never commit application data.
/backups/

# Visual-review captures from e2e/screenshots.spec.ts -- regenerated on demand,
# not source.
frontend/screenshots/

# Client contract documents — not for the repo
SOW - Praverse*.pdf

# Per-session review hand-off and branch-cleanup working files (see CLAUDE.md);
# rebuilt locally every session, never committed.
/review-handoff/
/review-handoff.zip
/branch-cleanup/
